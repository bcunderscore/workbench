---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import ActivityList from '../components/ActivityList.astro';
import { buildActivity } from '../lib/activity';
import { publishedOnly } from '../lib/content';

const projects = publishedOnly(await getCollection('projects'));
const posts = publishedOnly(await getCollection('posts'));

const featured = [
  ...projects
    .filter((p) => p.data.featured)
    .map((p) => ({ type: 'project' as const, date: p.data.date, project: p })),
  ...posts
    .filter((p) => p.data.featured)
    .map((p) => ({ type: 'post' as const, date: p.data.date, post: p })),
]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 3);

const activity = buildActivity(projects, posts, 8);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Bryce Campbell',
  jobTitle: 'Software engineer',
  url: 'https://brycecampbell.com',
  sameAs: ['https://github.com/bcunderscore'],
};
---

<BaseLayout
  title="Bryce Campbell's Workbench"
  description="The workbench of Bryce Campbell: software projects, keyboard builds, 3D prints, and notes on CAD and PCB design."
  jsonLd={jsonLd}
>
  <h1 class="text-3xl font-extrabold leading-tight sm:text-4xl">
    Bryce Campbell's<br />Workbench
  </h1>
  <p class="mt-2 font-mono text-sm text-accent">// software · keyboards · 3d printing</p>

  {
    featured.length > 0 && (
      <section class="mt-10">
        <h2 class="mb-3 label-mono text-muted">Featured</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {featured.map((item) =>
            item.type === 'project' ? (
              <ProjectCard project={item.project} />
            ) : (
              <PostCard post={item.post} />
            ),
          )}
        </div>
      </section>
    )
  }

  {
    activity.length > 0 && (
      <section class="mt-10">
        <h2 class="mb-3 label-mono text-muted">Recent activity</h2>
        <ActivityList items={activity} />
      </section>
    )
  }
</BaseLayout>
