---
import BaseLayout from '../layouts/BaseLayout.astro';

// Bryce: fill these in — one string per item, e.g. 'ZSA Voyager — daily driver at work'.
// Sections with no items don't render, so the page grows as you fill it out.
const sections: { heading: string; items: string[] }[] = [
  { heading: 'Keyboards', items: [] },
  { heading: 'Software', items: [] },
  { heading: 'Desk', items: [] },
  { heading: 'Making', items: [] },
];

const filled = sections.filter((s) => s.items.length > 0);
---

<BaseLayout
  title="Uses — Bryce Campbell"
  description="The hardware and software on Bryce Campbell's workbench."
>
  <h1 class="text-2xl font-extrabold">Uses</h1>
  <p class="mt-2 text-muted">What's on the bench right now.</p>

  {
    filled.length === 0 ? (
      <p class="mt-6 text-muted">
        Still taking inventory — I'm writing this page by hand, not generating it. Check back
        soon.
      </p>
    ) : (
      filled.map((s) => (
        <section class="mt-8">
          <h2 class="mb-2 label-mono text-accent">{s.heading}</h2>
          <ul class="list-disc pl-6 leading-7">
            {s.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      ))
    )
  }
</BaseLayout>
