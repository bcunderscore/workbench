---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpecSheet from '../../components/SpecSheet.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import { publishedOnly } from '../../lib/content';
import { formatLong, formatShort } from '../../lib/dates';

export async function getStaticPaths() {
  const projects = publishedOnly(await getCollection('projects'));
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, description, categories, date, status, links, cover, gallery, specs } = project.data;
const { Content } = await render(project);

const ogCover = cover ? (await getImage({ src: cover, width: 1200 })).src : undefined;

const relatedPosts = publishedOnly(await getCollection('posts'))
  .filter((p) => p.data.project?.id === project.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={`${title} — Bryce Campbell`} description={description} image={ogCover}>
  <p class="label-mono text-accent">{categories.join(' · ')}</p>
  <h1 class="mt-1 text-3xl font-extrabold">{title}</h1>
  <p class="mt-2 text-muted">{description}</p>
  <p class="mt-2 font-mono text-xs text-muted">{formatLong(date)} · {status}</p>

  {
    (links?.repo || links?.live) && (
      <div class="mt-4 flex gap-3">
        {links?.repo && (
          <a
            href={links.repo}
            class="btn-accent"
          >
            repo ↗
          </a>
        )}
        {links?.live && (
          <a
            href={links.live}
            class="btn-accent"
          >
            live ↗
          </a>
        )}
      </div>
    )
  }

  {
    cover && (
      <Image
        src={cover}
        alt={title}
        widths={[800, 1600]}
        sizes="(min-width: 768px) 768px, 100vw"
        class="mt-8 w-full"
        loading="eager"
        fetchpriority="high"
      />
    )
  }

  {specs && Object.keys(specs).length > 0 && <div class="mt-8"><SpecSheet specs={specs} /></div>}

  {gallery.length > 0 && <div class="mt-8"><GalleryGrid images={gallery} title={title} /></div>}

  <div class="mdx-body mt-8"><Content /></div>

  {
    relatedPosts.length > 0 && (
      <section class="mt-10">
        <h2 class="mb-3 label-mono text-muted">Build logs & posts</h2>
        <ul>
          {relatedPosts.map((p) => (
            <li class="border-t border-rule last:border-b">
              <a
                href={`/writing/${p.id}/`}
                class="flex items-baseline justify-between gap-4 py-2.5 transition-colors hover:text-accent"
              >
                <span>{p.data.title}</span>
                <span class="shrink-0 font-mono text-xs text-muted">{formatShort(p.data.date)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
