---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DraftBadge from '../../components/DraftBadge.astro';
import { publishedOnly } from '../../lib/content';
import { formatShort } from '../../lib/dates';

const posts = publishedOnly(await getCollection('posts')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout
  title="Writing — Bryce Campbell"
  description="Build logs and notes on software, keyboards, CAD, PCB design, and 3D printing."
>
  <h1 class="text-2xl font-extrabold">Writing</h1>

  {
    posts.length === 0 ? (
      <p class="mt-6 text-muted">Nothing here yet — the first post is still on the bench.</p>
    ) : (
      <ul class="mt-6">
        {posts.map((post) => (
          <li class="border-t border-rule last:border-b">
            <a href={`/writing/${post.id}/`} class="group block py-4">
              <div class="flex items-baseline justify-between gap-4">
                <h2 class="flex items-center gap-2 font-bold transition-colors group-hover:text-accent">
                  {post.data.title}
                  <DraftBadge draft={post.data.draft} />
                </h2>
                <span class="shrink-0 font-mono text-xs text-muted">{formatShort(post.data.date)}</span>
              </div>
              <p class="mt-1 text-sm text-muted">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
