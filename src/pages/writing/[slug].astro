---
import { getCollection, getEntry, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedOnly } from '../../lib/content';
import { formatFull } from '../../lib/dates';

export async function getStaticPaths() {
  const posts = publishedOnly(await getCollection('posts'));
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const linked = post.data.project ? await getEntry(post.data.project) : undefined;
const project = linked && publishedOnly([linked])[0];
const ogCover = post.data.cover ? (await getImage({ src: post.data.cover, width: 1200 })).src : undefined;
---

<BaseLayout
  title={`${post.data.title} — Bryce Campbell`}
  description={post.data.description}
  image={ogCover}
  ogType="article"
  publishedTime={post.data.date}
>
  <p class="label-mono text-accent">writing</p>
  <h1 class="mt-1 text-3xl font-extrabold">{post.data.title}</h1>
  <p class="mt-2 font-mono text-xs text-muted">
    {formatFull(post.data.date)}
    {post.data.tags.length > 0 && <> · {post.data.tags.join(' · ')}</>}
  </p>

  {
    project && (
      <p class="mt-3 font-mono text-sm">
        <a href={`/projects/${project.id}/`} class="text-accent underline">
          ↳ part of {project.data.title}
        </a>
      </p>
    )
  }

  <div class="mdx-body mt-8"><Content /></div>
</BaseLayout>
