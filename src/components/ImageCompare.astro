---
import { Image } from 'astro:assets';

interface Props {
  left: ImageMetadata;
  right: ImageMetadata;
  leftAlt: string;
  rightAlt: string;
  leftLabel?: string;
  rightLabel?: string;
  caption?: string;
}

const { left, right, leftAlt, rightAlt, leftLabel, rightLabel, caption } = Astro.props;
---

<figure class="image-compare">
  <div class="frame" style="--pos: 50%">
    <Image src={left} alt={leftAlt} widths={[800, 1600]} sizes="(min-width: 768px) 768px, 100vw" />
    <div class="right-wrap" aria-hidden="true">
      <Image src={right} alt="" widths={[800, 1600]} sizes="(min-width: 768px) 768px, 100vw" />
    </div>
    <div class="divider" aria-hidden="true"></div>
    {leftLabel && <span class="label label-left" aria-hidden="true">{leftLabel}</span>}
    {rightLabel && <span class="label label-right" aria-hidden="true">{rightLabel}</span>}
    <input type="range" min="0" max="100" value="50" step="0.5" aria-label={`Comparison slider: ${leftAlt} / ${rightAlt}`} />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .image-compare {
    margin-top: 1em;
  }
  .frame {
    position: relative;
    user-select: none;
  }
  .image-compare :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .right-wrap {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 var(--pos));
  }
  .right-wrap :global(img) {
    height: 100%;
    object-fit: cover;
  }
  .divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    background: var(--accent-c);
    transform: translateX(-1px);
  }
  .divider::after {
    content: '◂ ▸';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: var(--accent-c);
    color: var(--accent-ink-c);
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 4px 6px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .label {
    position: absolute;
    top: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #fff;
    background: rgba(0, 0, 0, 0.55);
    padding: 2px 8px;
  }
  .label-left {
    left: 8px;
  }
  .label-right {
    right: 8px;
  }
  input[type='range'] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: ew-resize;
    margin: 0;
  }
  figcaption {
    margin-top: 0.5em;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted-c);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.image-compare').forEach((root) => {
    const frame = root.querySelector<HTMLElement>('.frame');
    const range = root.querySelector<HTMLInputElement>('input[type="range"]');
    range?.addEventListener('input', () => {
      frame?.style.setProperty('--pos', `${range.value}%`);
    });
  });
</script>
